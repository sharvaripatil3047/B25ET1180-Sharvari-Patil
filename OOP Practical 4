#include <iostream>
using namespace std;

class Complex
{
    float real, imag;

public:
    void getData()
    {
        cout << "Enter real part: ";
        cin >> real;
        cout << "Enter imaginary part: ";
        cin >> imag;
    }

    void cube()
    {
        float r, i;

        r = real * real * real - 3 * real * imag * imag;
        i = 3 * real * real * imag - imag * imag * imag;

        cout << "Cube of complex number = "
             << r << " + (" << i << ")i" << endl;
    }
};

int main()
{
    Complex c;
    c.getData();
    c.cube();

    return 0;
}
